{
  "name": "@notross/codesnip",
  "version": "1.0.0",
  "main": "index.js",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.5.2",
    "concurrently": "^9.2.1",
    "css-loader": "^7.1.2",
    "html-webpack-plugin": "^5.6.4",
    "sass": "^1.92.1",
    "style-loader": "^4.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2",
    "webpack": "^5.101.3",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.2"
  },
  "scripts": {
    "bundle": "webpack",
    "style": "sass src/styles:dist/css",
    "build": "npm run style && npm run bundle",
    "style:watch": "sass --watch src/styles:dist/css",
    "serve": "webpack serve",
    "dev": "concurrently \"npm run style:watch\" \"npm run serve\""
  },
  "dependencies": {
    "modern-monaco": "^0.2.1"
  }
}
